<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: white;" stylesheets="@../style/visualNovel.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fx:id="backgroundImage" fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true" />
      <AnchorPane layoutX="2.0" layoutY="678.0" prefHeight="402.0" prefWidth="1912.0">
         <children>
            <Label fx:id="dialogue" alignment="CENTER" layoutX="-10.0" layoutY="-2.0" prefHeight="402.0" prefWidth="1923.0" textAlignment="CENTER">
               <font>
                  <Font size="28.0" />
               </font>
               <styleClass>
                  <String fx:value="dialogue-text" />
                  <String fx:value="dialogue-pane" />
               </styleClass>
            </Label>
            <Button fx:id="nextButton" layoutX="1680.0" layoutY="234.0" mnemonicParsing="false" onAction="#next" prefHeight="50.0" prefWidth="133.0" styleClass="vn-choice-button" text="Next">
               <font>
                  <Font size="28.0" />
               </font>
            </Button>
            <Label fx:id="speaker" alignment="CENTER" layoutX="318.0" layoutY="53.0" prefHeight="67.0" prefWidth="152.0" styleClass="speaker-label" text="name" textAlignment="CENTER">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button fx:id="skipButton" layoutX="140.0" layoutY="234.0" mnemonicParsing="false" onAction="#skip" prefHeight="50.0" prefWidth="133.0" styleClass="vn-choice-button" text="Skip">
               <font>
                  <Font size="28.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <Button layoutX="1735.0" layoutY="48.0" mnemonicParsing="false" onAction="#pause" prefHeight="79.0" prefWidth="160.0" styleClass="vn-choice-button" text="Pause" textAlignment="CENTER">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Pane fx:id="completedPane" layoutX="410.0" layoutY="173.0" prefHeight="549.0" prefWidth="1150.0" style="-fx-background-color: red;">
         <children>
            <Button fx:id="returnButton" layoutX="349.0" layoutY="395.0" mnemonicParsing="false" onAction="#returnMenu" prefHeight="65.0" prefWidth="462.0" text="Return">
               <font>
                  <Font size="28.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</AnchorPane>
