<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<!-- Main gameplay screen (placeholder art, same idea as tutorial.fxml). The controller is set in code. -->

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" styleClass="gameplay-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@../style/debugBorder.css" />
      <URL value="@../style/mainMenuButton.css" />
      <URL value="@../style/visualNovel.css" />
      <URL value="@../style/gameplay.css" />
      <URL value="@../style/tutorial.css" />
   </stylesheets>
   <children>
      <ImageView fx:id="eraBackground" fitHeight="562.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true" />
      <Pane layoutY="562.0" prefHeight="522.0" prefWidth="1920.0" style="-fx-background-color: #450327;" />
      <Button fx:id="pauseButton" layoutX="1770.0" layoutY="20.0" mnemonicParsing="false" onAction="#pause" prefHeight="60.0" prefWidth="130.0" styleClass="game-button" text="Pause" />

      <!-- the battle: shown only while an enemy is being fought -->
      <Pane fx:id="battlePane" pickOnBounds="false" prefHeight="1080.0" prefWidth="1920.0">
         <children>
            <Pane layoutY="570.0" prefHeight="512.0" prefWidth="1920.0" styleClass="toolbox-texture" />
            <Pane layoutX="1555.0" layoutY="100.0" prefHeight="140.0" prefWidth="340.0" styleClass="dialog-frame">
               <children>
                  <Label fx:id="enemyStatsLabel" alignment="TOP_LEFT" layoutX="36.0" layoutY="26.0" prefHeight="104.0" prefWidth="292.0" styleClass="status-text-style" stylesheets="@../style/tutorial.css">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
            <Pane layoutX="25.0" layoutY="100.0" prefHeight="140.0" prefWidth="340.0" styleClass="dialog-frame">
               <children>
                  <Label fx:id="playerStatsLabel" alignment="TOP_LEFT" layoutX="36.0" layoutY="31.0" prefHeight="95.0" prefWidth="296.0" styleClass="status-text-style">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </children>
            </Pane>

            <!-- placeholder sprites -->
            <ImageView fx:id="playerImageView" fitHeight="256.0" fitWidth="256.0" layoutX="14.0" layoutY="330.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="enemyImageView" fitHeight="256.0" fitWidth="256.0" layoutX="1624.0" layoutY="282.0" pickOnBounds="true" preserveRatio="true" />

            <!-- the question: dialogue frame (its transparent margins extend past the visible panel) -->
            <Pane layoutX="433.0" layoutY="120.0" pickOnBounds="false" prefHeight="453.0" prefWidth="1057.0">
               <children>
                  <ScrollPane fx:id="questionScrollPane" fitToWidth="true" layoutX="26.0" layoutY="78.0" pannable="true" prefHeight="281.0" prefWidth="1009.0">
                     <content>
                        <Label fx:id="questionLabel" alignment="TOP_LEFT" style="-fx-font-size: 24px;" styleClass="dialogue-text, question-text" wrapText="true" />
                     </content>
                  </ScrollPane>
               </children>
               <styleClass>
                  <String fx:value="question-pane" />
                  <String fx:value="status-text-style" />
               </styleClass></Pane>
            <Label fx:id="questionHeaderLabel" alignment="CENTER" layoutX="415.0" layoutY="138.0" prefHeight="36.0" prefWidth="440.0" style="-fx-font-size: 20px;" styleClass="speaker-label" text="Question" />
            <Label fx:id="messageLabel" alignment="CENTER" layoutX="450.0" layoutY="470.0" prefHeight="55.0" prefWidth="1021.0" style="-fx-font-size: 20px;" styleClass="dialogue-text, question-text" wrapText="true" />
            <Label fx:id="timerLabel" alignment="CENTER_RIGHT" layoutX="790.0" layoutY="120.0" prefHeight="36.0" prefWidth="230.0" style="-fx-font-size: 24px;" styleClass="timer-label" text="" />
            <Pane layoutX="85.0" layoutY="625.0" prefHeight="402.0" prefWidth="320.0" styleClass="toolbox-pane">
               <children>
                  <Button fx:id="debugButton" layoutX="45.0" layoutY="27.0" maxWidth="1.7976931348623157E308" minHeight="64.0" mnemonicParsing="false" onAction="#useDebug" prefHeight="64.0" prefWidth="243.0" styleClass="game-button, lifeline-button" text="Debug" />
                  <Button fx:id="databaseButton" layoutX="48.0" layoutY="209.0" maxWidth="1.7976931348623157E308" minHeight="85.0" mnemonicParsing="false" onAction="#useDatabase" prefHeight="64.0" prefWidth="243.0" styleClass="game-button, lifeline-button" text="Database" />
                  <Button fx:id="consultButton" layoutX="44.0" layoutY="298.0" maxWidth="1.7976931348623157E308" minHeight="85.0" mnemonicParsing="false" onAction="#useConsult" prefHeight="64.0" prefWidth="243.0" styleClass="game-button, lifeline-button" text="Consult" />
                  <Button fx:id="saveButton" layoutX="44.0" layoutY="110.0" maxWidth="1.7976931348623157E308" minHeight="85.0" mnemonicParsing="false" onAction="#useSave" prefHeight="64.0" prefWidth="243.0" styleClass="game-button, lifeline-button" text="Save" />
               </children>
            </Pane>
            <Pane layoutX="420.0" layoutY="584.0" prefHeight="373.0" prefWidth="1460.0">
               <children>
      
                              <!-- the answer choices: one choice is shown at a time, Previous / Next move between them (same as the tutorial) -->
                  <ScrollPane fx:id="choicesScrollPane" fitToWidth="true" layoutX="20.0" layoutY="44.0" prefHeight="317.0" prefWidth="1428.0">
                     <content>
                        <Label fx:id="choicesLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="100.0" layoutY="100.0" styleClass="dialogue-text, choice-display" wrapText="true" />
                     </content>
                  </ScrollPane>
               </children>
            </Pane>
            <Button fx:id="prevButton" layoutX="420.0" layoutY="935.0" mnemonicParsing="false" onAction="#prevChoice" prefHeight="90.0" prefWidth="380.0" styleClass="game-button, big-button" text="Previous" />
            <Button fx:id="selectButton" layoutX="830.0" layoutY="935.0" mnemonicParsing="false" onAction="#selectChoice" prefHeight="90.0" prefWidth="640.0" styleClass="game-button, big-button" text="Select Choice" />
            <Button fx:id="nextButton" layoutX="1500.0" layoutY="935.0" mnemonicParsing="false" onAction="#nextChoice" prefHeight="90.0" prefWidth="380.0" styleClass="game-button, big-button" text="Next" />
            <Pane layoutX="394.0" layoutY="5.0" prefHeight="117.0" prefWidth="1104.0" styleClass="status-pane">
               <children>
            
                        <!-- always visible: era + encounter + pause -->
                  <Label fx:id="eraLabel" alignment="CENTER" layoutX="48.0" layoutY="9.0" prefHeight="40.0" prefWidth="1000.0" text="Era">
                     <font>
                        <Font size="30.0" />
                     </font>
                  </Label>
                  <Label fx:id="encounterLabel" alignment="CENTER" layoutX="54.0" layoutY="49.0" prefHeight="30.0" prefWidth="1000.0" text="Encounter">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
         </children>
      </Pane>

                              <!-- full-screen message: era intro, encounter intro/cleared, era cleared, game over -->
      <Pane fx:id="bannerPane" layoutX="310.0" layoutY="130.0" styleClass="dialogue-pane">
         <children>
            <Label fx:id="bannerTitleLabel" alignment="CENTER" layoutX="60.0" layoutY="142.0" prefHeight="70.0" prefWidth="1180.0" style="-fx-font-size: 40px;" styleClass="speaker-label" text="Title" wrapText="true" />
            <Button fx:id="bannerButton" layoutX="415.0" layoutY="402.0" mnemonicParsing="false" onAction="#bannerButtonPressed" prefHeight="70.0" prefWidth="460.0" styleClass="game-button, big-button" text="Continue" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutX="100.0" layoutY="203.0" prefHeight="169.0" prefWidth="1080.0">
               <content>
                  <Label fx:id="bannerBodyLabel" alignment="TOP_CENTER" style="-fx-font-size: 26px;" styleClass="dialogue-text" text="Body" wrapText="true" />
               </content>
            </ScrollPane>
         </children>
      </Pane>
   </children>
</AnchorPane>
